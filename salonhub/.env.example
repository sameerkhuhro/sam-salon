# SalonHub Web Application - Environment Variables Template
# Copy this file to .env for local development

# Frontend Application Port
PORT=5173

# Future Backend API Base URL (Phase 2 Integration)
# VITE_API_URL=http://localhost:5000/api

# Regional Timezone (Pakistan Standard Time)
VITE_SALON_TIMEZONE=Asia/Karachi
VITE_SALON_CURRENCY=PKR

