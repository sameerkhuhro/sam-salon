# SalonHub Backend Environment Variables
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Supports Local MongoDB or MongoDB Atlas)
# Example Local: mongodb://127.0.0.1:27017/salonhub
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/salonhub?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/salonhub

# JWT Authentication Secret & Expiration
JWT_SECRET=change_this_to_a_secure_random_secret_in_production
JWT_EXPIRES_IN=7d

# Initial Setup Admin Credentials (Used on first run seed)
INITIAL_ADMIN_NAME=Salon Owner
INITIAL_ADMIN_EMAIL=admin@salonhub.pk
INITIAL_ADMIN_PASSWORD=replace_with_a_secure_password
INITIAL_ADMIN_PHONE=+92 300 1234567

# Allowed CORS Origins (Comma-separated)
CLIENT_ORIGINS=http://localhost:5173,http://localhost:5174
